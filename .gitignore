# =============================================================================
# Money/dataset governance — enforced by `12` §3 and NFR-SEC-004
# =============================================================================

# --- DATASET BYTES MUST NEVER BE COMMITTED --------------------------------
# `12` §3: "Do not redistribute the dataset outside permitted terms."
# `06` §5: raw package stays outside version control.
# SPIKE_D_DATASET/TASK.md forbids "Committing dataset bytes to the repository".
#
# The MANIFEST is tracked (it is the GATE-DATA-01 acceptance artifact);
# the raw volumes are not.
data/**
!data/manifests/
!data/manifests/**
*.nrrd
*.nii
*.nii.gz
*.dcm
*.mha
*.mhd
*.raw

# --- MODEL WEIGHTS / CHECKPOINTS ------------------------------------------
# Referenced by id/checksum in experiment manifests (`08` §10), not committed.
*.pt
*.pth
*.ckpt
*.safetensors
*.onnx
checkpoints/
runs/
wandb/

# --- ML PIPELINE DERIVED ARRAYS (ml/) -------------------------------------
# The slice cache, run directories and predictions live OUTSIDE git
# (<CARDIAC_DATA_ROOT>\cache\<split_id>\img<img>\ and the run directories; see
# ml/README.md "Data locations"); ml/data.py refuses a cache directory inside a work
# tree. These lines catch a mistaken path: a resized patient array is still dataset bytes.
*.npy
*.npz
ml/**/cache/
ml/**/predictions/

# --- SECRETS --------------------------------------------------------------
# NFR-SEC-004: "Secrets/config credentials shall not be committed."
# `12` §6: store secrets in environment/secret configuration, never in source.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.keystore
*.jks
secrets/
credentials.json
service-account*.json

# --- SPIKE / MEASUREMENT SCRATCH ------------------------------------------
# Spike harnesses are throwaway; RESULT.md and evidence artifacts ARE tracked.
spikes/**/build/
spikes/**/.gradle/
spikes/**/node_modules/

# --- SPIKE SCAFFOLDING ----------------------------------------------------
# expo prebuild regenerates spikes/**/android/ from app.json, so it is build
# output rather than source. The spike is throwaway; the native project is
# reproducible with `npx expo run:android`.
spikes/**/android/
spikes/**/.expo/
spikes/**/ios/

# --- PYTHON ---------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ipynb_checkpoints/

# --- NODE / MOBILE --------------------------------------------------------
node_modules/
.expo/
*.apk
*.aab
*.ipa
local.properties

# --- OS / EDITOR ----------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*~

# --- SPIKE MESH ARTIFACTS -------------------------------------------------
# DAY01_VU_HUNG_ANH.md: large mesh artifacts stay out of git; record the
# checksum and the command that regenerates them instead. The JSON summaries
# next to them ARE tracked - they are the diagnostic record.
spikes/**/mesh/out/*.obj

# --- BYTES DERIVED FROM A REAL MASK (Spike B, Day 22) ----------------------
# Everything under mesh/out_real/ is computed from a patient segmentation: the
# OBJ decimation levels, the per-ray error table, the mask slice images and the
# staged device assets. Those bytes live only in this ignored folder and inside
# the measurement APK. The tracked record is the small JSON evidence (counts,
# timings, errors, sha256) under spikes/spike_b_3d/EVIDENCE_RAW/.
spikes/**/mesh/out_real/

# --- SPIKE E PAYLOADS -----------------------------------------------------
# Generated synthetic payloads: large and reproducible, so the generator is
# tracked and the bytes are not. Regenerate with payloads/generate.py.
spikes/**/payloads/out/
spikes/**/payloads/out_*/

# --- GENERATED FIXTURE BUNDLE ---------------------------------------------
# contract.json says fixture_rules.handwritten_fixtures_allowed = false, so a
# committed bundle would be a fixture nobody can prove was generated. CI
# regenerates it from the contract on every run; app/core/fixtures/FORMAT.md
# is the tracked artifact, the bundle is not.
app/core/fixtures/.generated/

# --- SPIKE A FIXTURE AT REAL SLICE SIZE -----------------------------------
# The 64x64 fixture IS tracked - it is small and it anchors the conformance
# checks. The 576x576 regeneration used to re-measure A9 at the real cohort
# slice size is ~6.8 MB per file and is NOT committed: the generator plus the
# exact command reproduce it byte for byte, and the run records the sha256.
#
#     python spikes/spike_a_2d/fixtures/generate.py --nx 576 --ny 576
#
# Guarded by size, not by name, so any oversized regeneration is caught.
spikes/spike_a_2d/fixtures/*_576.json
