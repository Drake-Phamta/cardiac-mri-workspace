# =============================================================================
# Dataset governance — enforced by `12` §3 and NFR-SEC-004
# =============================================================================

# --- DATASET BYTES MUST NEVER BE COMMITTED --------------------------------
# `12` §3: "Do not redistribute the dataset outside permitted terms."
# `06` §5: raw package stays outside version control.
#
# The manifests and the generated dataset audit are tracked; the raw volumes are not.
data/**
!data/manifests/
!data/manifests/**
!data/DATASET_AUDIT.md

# backend/ derived data: slice PNGs and masks rendered from patient images,
# Contract 2 experiment packages (predictions), the review database and its
# reviewed masks. All derived from patient images; none is ever committed.
backend/data_cache/
backend/experiments/
backend/var/
*.nrrd
*.nii
*.nii.gz
*.dcm
*.mha
*.mhd
*.raw

# --- MODEL WEIGHTS / CHECKPOINTS ------------------------------------------
# Referenced by id/checksum in experiment manifests (`08` §10), not committed.
*.pt
*.pth
*.ckpt
*.safetensors
*.onnx
checkpoints/
runs/
wandb/

# --- ML PIPELINE DERIVED ARRAYS (ml/) -------------------------------------
# The slice cache, run directories and predictions live OUTSIDE git
# (<CARDIAC_DATA_ROOT>\cache\<split_id>\img<img>\ and the run directories; see
# ml/README.md "Data locations"); ml/data.py refuses a cache directory inside a work
# tree. These lines catch a mistaken path: a resized patient array is still dataset bytes.
*.npy
*.npz
ml/**/cache/
ml/**/predictions/

# --- SECRETS --------------------------------------------------------------
# NFR-SEC-004: "Secrets/config credentials shall not be committed."
# `12` §6: store secrets in environment/secret configuration, never in source.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.keystore
*.jks
secrets/
credentials.json
service-account*.json

# --- PROTOTYPE BUILD OUTPUT -----------------------------------------------
# expo prebuild regenerates prototypes/**/android/ from app.json, so it is build
# output rather than source; `npx expo run:android` reproduces it.
prototypes/**/build/
prototypes/**/.gradle/
prototypes/**/node_modules/
prototypes/**/android/
prototypes/**/.expo/
prototypes/**/ios/

# --- PYTHON ---------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ipynb_checkpoints/

# --- NODE / MOBILE --------------------------------------------------------
node_modules/
.expo/
*.apk
*.aab
*.ipa
local.properties

# --- OS / EDITOR ----------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*~

# --- PROTOTYPE MESH ARTIFACTS ---------------------------------------------
# Large mesh files stay out of git; the JSON summaries next to them are tracked.
prototypes/**/mesh/out/*.obj

# --- BYTES DERIVED FROM A REAL MASK (3D viewer prototype) ------------------
# Everything under mesh/out_real/ is computed from a patient segmentation: the
# OBJ decimation levels, the per-ray error table, the mask slice images and the
# staged device assets. Those bytes live only in this ignored folder.
prototypes/**/mesh/out_real/

# --- TRANSPORT PROTOTYPE PAYLOADS -----------------------------------------
# Generated synthetic payloads: large and reproducible, so the generator is
# tracked and the bytes are not. Regenerate with payloads/generate.py.
prototypes/**/payloads/out/
prototypes/**/payloads/out_*/

# --- GENERATED FIXTURE BUNDLE ---------------------------------------------
# contract.json says fixture_rules.handwritten_fixtures_allowed = false, so a
# committed bundle would be a fixture nobody can prove was generated. CI
# regenerates it from the contract on every run; app/core/fixtures/FORMAT.md
# is the tracked artifact, the bundle is not.
app/core/fixtures/.generated/
