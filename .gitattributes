# Line-ending policy.
#
# The specification is checked with `sha256sum -c` (docs/specs/v1.0), which
# hashes the WORKING COPY. On Windows, core.autocrlf=true would rewrite LF to
# CRLF on checkout and change every hash although the committed blob is
# correct. -text turns conversion off, so the working copy stays byte-identical
# to the blob on every platform and the checksum check means what it says.
docs/specs/v1.0/**          -text

# Manifests and checksummed fixtures must round-trip byte for byte.
*.sha256                    -text
SPEC_MANIFEST_SHA256.txt    -text
mobile/src/screens/**/fixtures/** -text
prototypes/**/fixtures/**   -text
prototypes/**/fixtures_proposal/** -text
data/manifests/**           -text

# Everything else: stored as LF, checked out as LF.
*.py      text eol=lf
*.js      text eol=lf
*.mjs     text eol=lf
*.json    text eol=lf
*.yaml    text eol=lf
*.yml     text eol=lf
*.md      text eol=lf
*.txt     text eol=lf
*.html    text eol=lf
*.sh      text eol=lf
*.ps1     text eol=lf

# Binary.
*.png     binary
*.jpg     binary
*.apk     binary
*.zip     binary
*.nrrd    binary
*.npy     binary
