{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cardiac-mri-workspace.local/contracts/ingestion/contract1-raw-dataset-draft-v0.schema.json",
  "title": "Contract 1 raw dataset ingestion manifest (DRAFT v0)",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "contract_version", "manifest_id", "dataset", "gate", "cases"],
  "properties": {
    "contract": { "const": "contract1_raw_dataset" },
    "contract_version": { "const": "DRAFT v0" },
    "manifest_id": {
      "type": "string",
      "pattern": "^raw-[a-z0-9][a-z0-9._-]*$"
    },
    "dataset": { "$ref": "#/$defs/dataset" },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gate_data_01"],
      "properties": {
        "gate_data_01": { "enum": ["ACCEPTED"] },
        "validated_manifest_uri": {
          "type": "string",
          "pattern": "^artifact://manifests/[a-z0-9][a-z0-9._/-]*$"
        }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/case" }
    }
  },
  "$defs": {
    "sha256": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "value"],
      "properties": {
        "algorithm": { "const": "sha256" },
        "value": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dataset_id",
        "name",
        "source_url",
        "dataset_version_or_acquisition_tag",
        "package_checksum",
        "license_usage_notes",
        "geometry_validation_status",
        "split_protocol_id"
      ],
      "properties": {
        "dataset_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]+$"
        },
        "name": { "type": "string", "minLength": 1 },
        "source_url": { "type": "string", "format": "uri" },
        "dataset_version_or_acquisition_tag": { "type": "string", "minLength": 1 },
        "package_checksum": { "$ref": "#/$defs/sha256" },
        "license_usage_notes": { "type": "string", "minLength": 1 },
        "geometry_validation_status": {
          "enum": ["VALIDATED_AXIS_ALIGNED", "GEOMETRY_NOT_VALIDATED"]
        },
        "split_protocol_id": {
          "type": ["string", "null"],
          "minLength": 1
        }
      }
    },
    "geometry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "shape_xyz",
        "spacing_xyz",
        "origin_xyz",
        "direction_or_orientation",
        "geometry_validation_status"
      ],
      "properties": {
        "shape_xyz": {
          "type": "array",
          "prefixItems": [
            { "type": "integer", "minimum": 1 },
            { "type": "integer", "minimum": 1 },
            { "type": "integer", "minimum": 1 }
          ],
          "items": false
        },
        "spacing_xyz": {
          "type": "array",
          "prefixItems": [
            { "type": "number", "exclusiveMinimum": 0 },
            { "type": "number", "exclusiveMinimum": 0 },
            { "type": "number", "exclusiveMinimum": 0 }
          ],
          "items": false
        },
        "origin_xyz": {
          "type": "array",
          "prefixItems": [
            { "type": "number" },
            { "type": "number" },
            { "type": "number" }
          ],
          "items": false
        },
        "direction_or_orientation": {
          "type": "array",
          "prefixItems": [
            {
              "type": "array",
              "prefixItems": [
                { "type": "number" },
                { "type": "number" },
                { "type": "number" }
              ],
              "items": false
            },
            {
              "type": "array",
              "prefixItems": [
                { "type": "number" },
                { "type": "number" },
                { "type": "number" }
              ],
              "items": false
            },
            {
              "type": "array",
              "prefixItems": [
                { "type": "number" },
                { "type": "number" },
                { "type": "number" }
              ],
              "items": false
            }
          ],
          "items": false
        },
        "geometry_validation_status": {
          "enum": ["VALIDATED_AXIS_ALIGNED", "GEOMETRY_NOT_VALIDATED"]
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "volume_id",
        "artifact_uri",
        "source_path",
        "format",
        "shape_xyz",
        "spacing_xyz",
        "origin_xyz",
        "direction_or_orientation",
        "dtype",
        "checksum",
        "geometry_validation_status"
      ],
      "properties": {
        "volume_id": {
          "type": "string",
          "pattern": "^VOL_[A-Za-z0-9._-]+$"
        },
        "artifact_uri": {
          "type": "string",
          "pattern": "^artifact://[A-Za-z0-9][A-Za-z0-9._/-]*$"
        },
        "source_path": {
          "type": "string",
          "pattern": "^(?![A-Za-z]:)(?!/)(?!.*\\.\\.)[^\\\\]+$"
        },
        "format": { "const": "NRRD" },
        "shape_xyz": {
          "type": "array",
          "prefixItems": [
            { "type": "integer", "minimum": 1 },
            { "type": "integer", "minimum": 1 },
            { "type": "integer", "minimum": 1 }
          ],
          "items": false
        },
        "spacing_xyz": {
          "type": "array",
          "prefixItems": [
            { "type": "number", "exclusiveMinimum": 0 },
            { "type": "number", "exclusiveMinimum": 0 },
            { "type": "number", "exclusiveMinimum": 0 }
          ],
          "items": false
        },
        "origin_xyz": {
          "type": "array",
          "prefixItems": [
            { "type": "number" },
            { "type": "number" },
            { "type": "number" }
          ],
          "items": false
        },
        "direction_or_orientation": {
          "type": "array",
          "prefixItems": [
            {
              "type": "array",
              "prefixItems": [
                { "type": "number" },
                { "type": "number" },
                { "type": "number" }
              ],
              "items": false
            },
            {
              "type": "array",
              "prefixItems": [
                { "type": "number" },
                { "type": "number" },
                { "type": "number" }
              ],
              "items": false
            },
            {
              "type": "array",
              "prefixItems": [
                { "type": "number" },
                { "type": "number" },
                { "type": "number" }
              ],
              "items": false
            }
          ],
          "items": false
        },
        "dtype": { "enum": ["uint8", "int16", "float32"] },
        "checksum": { "$ref": "#/$defs/sha256" },
        "geometry_validation_status": {
          "enum": ["VALIDATED_AXIS_ALIGNED", "GEOMETRY_NOT_VALIDATED"]
        }
      }
    },
    "mask": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mask_id",
        "artifact_uri",
        "source_path",
        "format",
        "shape_xyz",
        "spacing_xyz",
        "origin_xyz",
        "direction_or_orientation",
        "dtype",
        "checksum",
        "geometry_validation_status",
        "label_semantics",
        "source",
        "label_values",
        "foreground_value",
        "background_value"
      ],
      "properties": {
        "mask_id": {
          "type": "string",
          "pattern": "^MASK_[A-Za-z0-9._-]+$"
        },
        "artifact_uri": {
          "type": "string",
          "pattern": "^artifact://[A-Za-z0-9][A-Za-z0-9._/-]*$"
        },
        "source_path": {
          "type": "string",
          "pattern": "^(?![A-Za-z]:)(?!/)(?!.*\\.\\.)[^\\\\]+$"
        },
        "format": { "const": "NRRD" },
        "shape_xyz": {
          "type": "array",
          "prefixItems": [
            { "type": "integer", "minimum": 1 },
            { "type": "integer", "minimum": 1 },
            { "type": "integer", "minimum": 1 }
          ],
          "items": false
        },
        "spacing_xyz": {
          "type": "array",
          "prefixItems": [
            { "type": "number", "exclusiveMinimum": 0 },
            { "type": "number", "exclusiveMinimum": 0 },
            { "type": "number", "exclusiveMinimum": 0 }
          ],
          "items": false
        },
        "origin_xyz": {
          "type": "array",
          "prefixItems": [
            { "type": "number" },
            { "type": "number" },
            { "type": "number" }
          ],
          "items": false
        },
        "direction_or_orientation": {
          "type": "array",
          "prefixItems": [
            {
              "type": "array",
              "prefixItems": [
                { "type": "number" },
                { "type": "number" },
                { "type": "number" }
              ],
              "items": false
            },
            {
              "type": "array",
              "prefixItems": [
                { "type": "number" },
                { "type": "number" },
                { "type": "number" }
              ],
              "items": false
            },
            {
              "type": "array",
              "prefixItems": [
                { "type": "number" },
                { "type": "number" },
                { "type": "number" }
              ],
              "items": false
            }
          ],
          "items": false
        },
        "dtype": { "const": "uint8" },
        "checksum": { "$ref": "#/$defs/sha256" },
        "geometry_validation_status": {
          "enum": ["VALIDATED_AXIS_ALIGNED", "GEOMETRY_NOT_VALIDATED"]
        },
        "label_semantics": { "const": "LA cavity" },
        "source": { "const": "dataset annotation" },
        "label_values": { "const": [0, 255] },
        "foreground_value": { "const": 255 },
        "background_value": { "const": 0 }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "shape_equal",
        "spacing_equal",
        "origin_equal",
        "directions_equal",
        "resampling_required"
      ],
      "properties": {
        "shape_equal": { "const": true },
        "spacing_equal": { "const": true },
        "origin_equal": { "const": true },
        "directions_equal": { "const": true },
        "resampling_required": { "const": false }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "dataset_id",
        "mode_capability",
        "volume_id",
        "ground_truth_mask_id",
        "mri_volume",
        "ground_truth_mask",
        "compatibility",
        "metadata"
      ],
      "properties": {
        "case_id": {
          "type": "string",
          "pattern": "^CASE_[0-9]{4,}$"
        },
        "dataset_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]+$"
        },
        "source_case_key": {
          "type": "string",
          "minLength": 1
        },
        "mode_capability": {
          "enum": ["EVALUATION", "INFERENCE_REVIEW"]
        },
        "volume_id": {
          "type": "string",
          "pattern": "^VOL_[A-Za-z0-9._-]+$"
        },
        "ground_truth_mask_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^MASK_[A-Za-z0-9._-]+$"
            },
            { "type": "null" }
          ]
        },
        "mri_volume": { "$ref": "#/$defs/artifact" },
        "ground_truth_mask": {
          "anyOf": [
            { "$ref": "#/$defs/mask" },
            { "type": "null" }
          ]
        },
        "compatibility": {
          "anyOf": [
            { "$ref": "#/$defs/compatibility" },
            { "type": "null" }
          ]
        },
        "metadata": {
          "type": "object",
          "propertyNames": {
            "enum": [
              "modality",
              "space",
              "encoding",
              "series_description",
              "scanner_model",
              "acquisition_tag",
              "source_partition"
            ]
          },
          "additionalProperties": {
            "type": ["string", "number", "boolean", "null"]
          }
        }
      }
    }
  }
}
