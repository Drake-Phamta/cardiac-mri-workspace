{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cardiac-mri-workspace.local/contracts/ingestion/contract2-experiment-artifact-draft-v0.schema.json",
  "title": "Contract 2 precomputed experiment-artifact manifest (DRAFT v0)",
  "description": "Offline ingestion contract for reproducible experiment outputs; not a production API.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract", "contract_version", "manifest_id", "generated_at", "precomputed",
    "gates", "experiment", "artifacts", "analysis_runs"
  ],
  "properties": {
    "contract": { "const": "contract2_experiment_artifact" },
    "contract_version": { "const": "DRAFT v0" },
    "manifest_id": {
      "type": "string",
      "pattern": "^exp-[a-z0-9][a-z0-9._-]*$"
    },
    "generated_at": { "type": "string", "minLength": 1 },
    "precomputed": { "const": true },
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gate_split_01", "gate_ml_01"],
      "properties": {
        "gate_split_01": { "enum": ["ACCEPTED", "BLOCKED", "OPEN"] },
        "gate_ml_01": { "enum": ["ACCEPTED", "BLOCKED", "OPEN"] }
      }
    },
    "experiment": { "$ref": "#/$defs/experiment" },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/artifact" }
    },
    "analysis_runs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/analysis_run" }
    }
  },
  "$defs": {
    "sha256": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "value"],
      "properties": {
        "algorithm": { "const": "sha256" },
        "value": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "manifest_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest_id", "path", "checksum"],
      "properties": {
        "manifest_id": { "type": "string", "minLength": 1 },
        "path": {
          "type": "string",
          "pattern": "^(?![A-Za-z]:)(?!/)(?!.*\\.\\.)[^\\\\]+$"
        },
        "checksum": { "$ref": "#/$defs/sha256" }
      }
    },
    "checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checkpoint_id", "path", "checksum"],
      "properties": {
        "checkpoint_id": { "type": "string", "minLength": 1 },
        "path": {
          "type": "string",
          "pattern": "^(?![A-Za-z]:)(?!/)(?!.*\\.\\.)[^\\\\]+$"
        },
        "checksum": { "$ref": "#/$defs/sha256" }
      }
    },
    "artifact_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id"],
      "properties": {
        "artifact_id": { "type": "string", "pattern": "^ART_[A-Za-z0-9._-]+$" }
      }
    },
    "experiment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "experiment_id", "model_family", "model_variant", "decoder", "training_fraction",
        "split_manifest", "training_subset_manifest", "seed", "preprocessing_version",
        "postprocessing_version", "prediction_variant", "evaluation_population_manifest",
        "evaluation_metric_version", "training_code_version", "checkpoint",
        "evaluation_code_version", "num_test_cases", "metrics_summary",
        "per_case_metrics", "per_slice_metrics"
      ],
      "properties": {
        "experiment_id": { "type": "string", "pattern": "^EXP-[A-Za-z0-9._-]+$" },
        "model_family": { "type": "string", "minLength": 1 },
        "model_variant": { "type": "string", "minLength": 1 },
        "decoder": { "type": "string", "minLength": 1 },
        "training_fraction": { "enum": [0.25, 0.5, 1.0] },
        "split_manifest": { "$ref": "#/$defs/manifest_ref" },
        "training_subset_manifest": { "$ref": "#/$defs/manifest_ref" },
        "seed": { "type": "integer" },
        "preprocessing_version": { "type": "string", "minLength": 1 },
        "postprocessing_version": { "type": "string", "minLength": 1 },
        "prediction_variant": { "enum": ["RAW_PREDICTION", "PROCESSED_PREDICTION"] },
        "evaluation_population_manifest": {
          "type": "object",
          "additionalProperties": false,
          "required": ["manifest_id", "path", "role", "case_count", "checksum"],
          "properties": {
            "manifest_id": { "type": "string", "minLength": 1 },
            "path": {
              "type": "string",
              "pattern": "^(?![A-Za-z]:)(?!/)(?!.*\\.\\.)[^\\\\]+$"
            },
            "role": { "const": "FINAL_HOLDOUT" },
            "case_count": { "const": 54 },
            "checksum": { "$ref": "#/$defs/sha256" }
          }
        },
        "evaluation_metric_version": { "type": "string", "minLength": 1 },
        "training_code_version": { "type": "string", "minLength": 1 },
        "checkpoint": { "$ref": "#/$defs/checkpoint" },
        "evaluation_code_version": { "type": "string", "minLength": 1 },
        "num_test_cases": { "const": 54 },
        "metrics_summary": { "$ref": "#/$defs/artifact_ref" },
        "per_case_metrics": { "$ref": "#/$defs/artifact_ref" },
        "per_slice_metrics": { "$ref": "#/$defs/artifact_ref" }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id", "kind", "artifact_uri", "source_path", "media_type",
        "checksum", "immutable"
      ],
      "properties": {
        "artifact_id": { "type": "string", "pattern": "^ART_[A-Za-z0-9._-]+$" },
        "kind": {
          "enum": [
            "RAW_PREDICTION_MASK", "PROCESSED_PREDICTION_MASK", "RECONSTRUCTION_3D",
            "METRIC_SET", "METRICS_SUMMARY", "PER_CASE_METRICS", "PER_SLICE_METRICS"
          ]
        },
        "artifact_uri": {
          "type": "string",
          "pattern": "^artifact://[A-Za-z0-9][A-Za-z0-9._/-]*$"
        },
        "source_path": {
          "type": "string",
          "pattern": "^(?![A-Za-z]:)(?!/)(?!.*\\.\\.)[^\\\\]+$"
        },
        "media_type": { "type": "string", "minLength": 1 },
        "checksum": { "$ref": "#/$defs/sha256" },
        "immutable": { "const": true },
        "case_id": { "type": ["string", "null"] },
        "analysis_run_id": { "type": ["string", "null"] },
        "source_artifact_id": { "type": ["string", "null"] },
        "source_mask_kind": {
          "enum": ["RAW_PREDICTION", "PROCESSED_PREDICTION", "GROUND_TRUTH", "REVIEWED"]
        },
        "reference_mask_id": { "type": ["string", "null"] },
        "reference_mask_kind": {
          "enum": ["GROUND_TRUTH", "REVIEWED"]
        },
        "prediction_mask_id": { "type": ["string", "null"] },
        "prediction_mask_kind": {
          "enum": ["RAW_PREDICTION", "PROCESSED_PREDICTION"]
        },
        "evaluation_version": { "type": ["string", "null"] }
      }
    },
    "analysis_run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "analysis_run_id", "case_id", "status", "attempt_no", "raw_prediction_mask_id",
        "processed_prediction_mask_id", "metric_set_ids", "reconstruction_ids", "failure_reason"
      ],
      "properties": {
        "analysis_run_id": { "type": "string", "pattern": "^RUN_[A-Za-z0-9._-]+$" },
        "case_id": { "type": "string", "pattern": "^CASE_[0-9]{4,}$" },
        "status": { "enum": ["SUCCEEDED", "FAILED"] },
        "attempt_no": { "type": "integer", "minimum": 1 },
        "raw_prediction_mask_id": { "type": "string", "pattern": "^ART_[A-Za-z0-9._-]+$" },
        "processed_prediction_mask_id": { "type": ["string", "null"] },
        "metric_set_ids": {
          "type": "array",
          "items": { "type": "string", "pattern": "^ART_[A-Za-z0-9._-]+$" }
        },
        "reconstruction_ids": {
          "type": "array",
          "items": { "type": "string", "pattern": "^ART_[A-Za-z0-9._-]+$" }
        },
        "failure_reason": { "type": ["string", "null"] }
      }
    }
  }
}
