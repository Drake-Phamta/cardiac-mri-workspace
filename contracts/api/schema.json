{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cardiac-mri-workspace.local/contracts/api-contract-11-v1.1.0.schema.json",
  "title": "Backend/mobile API Contract 11 (v1.1.0)",
  "description": "Schema-first semantic/API contract, frozen at v1.0.0 on 2026-10-01 (INT-11); v1.1.0 adds the V3/V4 freeze follow-ups additively.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract", "contract_version", "base_path", "geometry_contract",
    "domain_enums", "enum_bindings", "review_rules", "case_capability",
    "selection_rules", "metric_rules", "field_shapes", "shape_bindings",
    "binary_delivery", "hero_flow",
    "errors", "endpoints", "artifact_rules", "revision_rules", "fixture_rules"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "contract": { "const": "api_contract_11" },
    "contract_version": { "const": "1.1.0" },
    "base_path": { "const": "/api/v1" },
    "geometry_contract": { "$ref": "#/$defs/geometry_contract" },
    "domain_enums": { "$ref": "#/$defs/domain_enums" },
    "enum_bindings": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "array", "minItems": 1,
        "items": { "type": "string", "pattern": "^(\\*|[a-z][a-z0-9_]+)\\.((request|param)\\.)?[a-z_][a-z0-9_]*$" }
      }
    },
    "review_rules": { "$ref": "#/$defs/review_rules" },
    "case_capability": { "$ref": "#/$defs/case_capability" },
    "selection_rules": { "$ref": "#/$defs/selection_rules" },
    "metric_rules": { "$ref": "#/$defs/metric_rules" },
    "field_shapes": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "array", "minItems": 1, "items": { "type": "string" }
      }
    },
    "shape_bindings": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "array", "minItems": 1,
        "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]+\\.(request\\.)?[a-z_][a-z0-9_]*$" }
      }
    },
    "binary_delivery": { "$ref": "#/$defs/binary_delivery" },
    "hero_flow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "picking"],
      "properties": {
        "decision": { "type": "string", "minLength": 1 },
        "picking": { "type": "string", "minLength": 1 }
      }
    },
    "errors": {
      "type": "array",
      "minItems": 15,
      "items": { "$ref": "#/$defs/error_definition" }
    },
    "endpoints": {
      "type": "array",
      "minItems": 28,
      "items": { "$ref": "#/$defs/endpoint" }
    },
    "artifact_rules": { "$ref": "#/$defs/artifact_rules" },
    "revision_rules": { "$ref": "#/$defs/revision_rules" },
    "fixture_rules": { "$ref": "#/$defs/fixture_rules" }
  },
  "$defs": {
    "string_list": {
      "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }
    },
    "geometry_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version", "validation_status_field", "required_response_fields",
        "invalid_geometry_error", "index_convention", "unvalidated_geometry_rule"
      ],
      "properties": {
        "version": { "const": "dr008a-dr012/v1.0.0" },
        "validation_status_field": { "const": "geometry_validation_status" },
        "required_response_fields": {
          "type": "array",
          "const": [
            "geometry_contract_version", "geometry_validation_status",
            "shape", "index_convention", "spacing", "origin", "direction"
          ],
          "items": { "type": "string" }
        },
        "invalid_geometry_error": { "const": "GEOMETRY_NOT_VALIDATED" },
        "index_convention": { "const": "x=column,y=row,z=slice" },
        "unvalidated_geometry_rule": { "type": "string", "minLength": 1 }
      }
    },
    "domain_enums": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/string_list" },
      "required": [
        "review_status", "review_status_transitions", "finding_status", "finding_type",
        "case_mode", "case_result_status", "run_status", "prediction_variant", "metric_state",
        "geometry_validation_status", "source_mask_kind", "review_source_mask_kind", "mask_payload_encoding"
      ],
      "properties": {
        "review_status": { "const": ["NOT_REVIEWED", "ACCEPTED", "FLAGGED", "CORRECTED"] },
        "review_status_transitions": {
          "const": {
            "NOT_REVIEWED": ["ACCEPTED", "FLAGGED", "CORRECTED"],
            "FLAGGED": ["CORRECTED"],
            "ACCEPTED": ["FLAGGED", "CORRECTED"]
          }
        },
        "finding_status": { "const": ["OPEN", "RESOLVED"] },
        "finding_type": {
          "const": [
            "UNDER_SEGMENTATION", "OVER_SEGMENTATION", "BOUNDARY_DISAGREEMENT",
            "DISCONNECTED_ARTIFACT", "OTHER"
          ]
        },
        "case_mode": { "const": ["EVALUATION", "INFERENCE_REVIEW"] },
        "case_result_status": { "const": ["SUCCEEDED", "FAILED", "EXCLUDED", "WITHHELD"] },
        "run_status": { "const": ["QUEUED", "RUNNING", "SUCCEEDED", "FAILED"] },
        "prediction_variant": { "const": ["RAW", "PROCESSED"] },
        "metric_state": { "const": ["COMPUTED", "NOT_APPLICABLE"] },
        "geometry_validation_status": { "const": ["VALIDATED_AXIS_ALIGNED", "GEOMETRY_NOT_VALIDATED"] },
        "source_mask_kind": {
          "const": ["RAW_PREDICTION", "PROCESSED_PREDICTION", "GROUND_TRUTH", "REVIEWED"]
        },
        "review_source_mask_kind": { "const": ["RAW_PREDICTION", "PROCESSED_PREDICTION"] },
        "mask_payload_encoding": { "const": ["PNG_BASE64", "BITPACK_BASE64"] }
      }
    },
    "review_rules": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision", "state_enum", "transition_map", "initial_state", "create_allowed_states",
        "terminal_states", "corrected_requires_reviewed_mask", "commit_result_state",
        "corrected_only_via", "commit_atomicity",
        "invalid_transition_error", "audit_history_required", "scope_fields",
        "absent_review_means", "notes"
      ],
      "properties": {
        "decision": { "type": "string", "minLength": 1 },
        "state_enum": { "const": "review_status" },
        "transition_map": { "const": "review_status_transitions" },
        "initial_state": { "const": "NOT_REVIEWED" },
        "create_allowed_states": { "const": ["NOT_REVIEWED", "ACCEPTED", "FLAGGED"] },
        "terminal_states": { "const": ["CORRECTED"] },
        "corrected_requires_reviewed_mask": { "const": true },
        "commit_result_state": { "const": "CORRECTED" },
        "corrected_only_via": { "const": "review_commit" },
        "commit_atomicity": { "type": "string", "minLength": 1 },
        "invalid_transition_error": { "const": "INVALID_REVIEW_TRANSITION" },
        "audit_history_required": { "const": true },
        "scope_fields": { "const": ["run_id", "source_mask_id", "prediction_variant"] },
        "absent_review_means": { "const": "NOT_REVIEWED" },
        "notes": { "type": "string", "minLength": 1 }
      }
    },
    "case_capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision", "mode_field", "mode_enum", "ground_truth_field", "modes",
        "ground_truth_dependent_endpoints", "unavailable_error",
        "withheld_ground_truth_rule", "case_level_scope"
      ],
      "properties": {
        "decision": { "type": "string", "minLength": 1 },
        "mode_field": { "const": "mode" },
        "mode_enum": { "const": "case_mode" },
        "ground_truth_field": { "const": "ground_truth_available" },
        "modes": {
          "type": "object",
          "additionalProperties": false,
          "required": ["EVALUATION", "INFERENCE_REVIEW"],
          "properties": {
            "EVALUATION": {
              "type": "object",
              "additionalProperties": false,
              "required": ["ground_truth_available", "ground_truth_dependent_data"],
              "properties": {
                "ground_truth_available": { "const": true },
                "ground_truth_dependent_data": { "const": "SERVED" }
              }
            },
            "INFERENCE_REVIEW": {
              "type": "object",
              "additionalProperties": false,
              "required": ["ground_truth_available", "ground_truth_dependent_data"],
              "properties": {
                "ground_truth_available": { "const": false },
                "ground_truth_dependent_data": { "const": "GROUND_TRUTH_UNAVAILABLE" }
              }
            }
          }
        },
        "ground_truth_dependent_endpoints": { "$ref": "#/$defs/string_list" },
        "unavailable_error": { "const": "GROUND_TRUTH_UNAVAILABLE" },
        "withheld_ground_truth_rule": { "type": "string", "minLength": 1 },
        "case_level_scope": { "type": "string", "minLength": 1 }
      }
    },
    "selection_rules": {
      "type": "object",
      "additionalProperties": false,
      "required": ["worst_slice_selection", "outlier_selection"],
      "properties": {
        "outlier_selection": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "decision", "endpoint", "field", "rule_id", "selection_version", "block_fields",
            "case_fields", "metric_name", "cardinality", "eligibility", "ranking", "order"
          ],
          "properties": {
            "decision": { "type": "string", "minLength": 1 },
            "endpoint": { "const": "experiment_cases" },
            "field": { "const": "outlier_selection" },
            "rule_id": { "const": "DR-010" },
            "selection_version": { "const": "dr010-outlier/v1" },
            "block_fields": {
              "const": ["rule_id", "selection_version", "experiment_id", "prediction_variant", "metric_name", "cases"]
            },
            "case_fields": {
              "const": ["case_id", "analysis_run_id", "metric_value", "false_positives", "false_negatives"]
            },
            "metric_name": { "const": "dice" },
            "cardinality": { "const": 3 },
            "eligibility": { "type": "string", "minLength": 1 },
            "ranking": {
              "const": [
                "metric_value ascending",
                "false_positives + false_negatives descending",
                "case_id ascending"
              ]
            },
            "order": { "type": "string", "minLength": 1 }
          }
        },
        "worst_slice_selection": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "decision", "endpoint", "field", "rule_id", "selection_version", "block_fields",
            "slice_fields", "eligibility", "ranking", "order", "empty_rule", "count_unit"
          ],
          "properties": {
            "decision": { "type": "string", "minLength": 1 },
            "endpoint": { "const": "analysis_run_metrics" },
            "field": { "const": "worst_slice_selection" },
            "rule_id": { "const": "DR-010" },
            "selection_version": { "const": "dr010-worst-slice/v1" },
            "block_fields": { "const": ["rule_id", "selection_version", "slices"] },
            "slice_fields": { "const": ["slice_index", "dice", "false_positives", "false_negatives"] },
            "eligibility": { "type": "string", "minLength": 1 },
            "ranking": {
              "const": [
                "dice ascending",
                "false_positives + false_negatives descending",
                "slice_index ascending"
              ]
            },
            "order": { "type": "string", "minLength": 1 },
            "empty_rule": { "type": "string", "minLength": 1 },
            "count_unit": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "metric_rules": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_metric_fields", "count_unit", "relative_volume_error_unit", "slice_metric_value",
        "empty_slice_rule", "summary_statistics", "summary_rule",
        "physical_metrics_blocked_while_geometry_not_validated", "unavailable_rule"
      ],
      "properties": {
        "case_metric_fields": {
          "const": ["dice", "iou", "false_positives", "false_negatives", "relative_volume_error"]
        },
        "count_unit": { "const": "voxels" },
        "relative_volume_error_unit": { "type": "string", "minLength": 1 },
        "slice_metric_value": { "type": "string", "minLength": 1 },
        "empty_slice_rule": { "type": "string", "minLength": 1 },
        "summary_statistics": {
          "const": ["n", "mean", "std", "median", "q1", "q3", "min", "max", "ci95_low", "ci95_high"]
        },
        "summary_rule": { "type": "string", "minLength": 1 },
        "physical_metrics_blocked_while_geometry_not_validated": { "$ref": "#/$defs/string_list" },
        "unavailable_rule": { "type": "string", "minLength": 1 }
      }
    },
    "binary_delivery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision", "applies_to", "metadata_rule", "content_url_rule", "media_type",
        "slice_layout", "mask_values", "mask_payload_rule"
      ],
      "properties": {
        "decision": { "type": "string", "minLength": 1 },
        "applies_to": { "$ref": "#/$defs/string_list" },
        "metadata_rule": { "type": "string", "minLength": 1 },
        "content_url_rule": { "type": "string", "minLength": 1 },
        "media_type": { "const": "image/png" },
        "slice_layout": { "type": "string", "minLength": 1 },
        "mask_values": { "type": "string", "minLength": 1 },
        "mask_payload_rule": { "type": "string", "minLength": 1 }
      }
    },
    "error_definition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "http_status", "message_template"],
      "properties": {
        "code": {
          "enum": [
            "CASE_NOT_FOUND", "SLICE_OUT_OF_RANGE", "ARTIFACT_NOT_FOUND",
            "GROUND_TRUTH_UNAVAILABLE", "INVALID_REVIEW_TRANSITION",
            "STALE_REVISION", "IMMUTABLE_ARTIFACT", "GEOMETRY_NOT_VALIDATED",
            "GEOMETRY_MISMATCH", "RUN_NOT_DEPLOYABLE", "RUN_NOT_SUCCEEDED",
            "NON_COMPARABLE_EXPERIMENTS", "ANALYSIS_FAILED", "VALIDATION_ERROR",
            "UNAUTHORIZED"
          ]
        },
        "http_status": { "type": "integer", "minimum": 400, "maximum": 599 },
        "message_template": { "type": "string", "minLength": 1 }
      }
    },
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "method", "path", "semantic", "response_kind", "response_fields",
        "errors", "geometry_response", "revision_required", "artifact_write",
        "ground_truth_behavior", "hero_flow", "notes"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]+$" },
        "method": { "enum": ["GET", "POST", "PUT", "PATCH"] },
        "path": { "type": "string", "pattern": "^/api/v1/[a-zA-Z0-9_{}?=&./-]+$" },
        "semantic": { "type": "string", "minLength": 1 },
        "response_kind": { "enum": ["JSON", "BINARY", "ARTIFACT_REFERENCE", "ERROR_OR_JSON"] },
        "request_fields": { "type": "array", "items": { "type": "string" } },
        "response_fields": { "type": "array", "items": { "type": "string" } },
        "row_fields": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "errors": {
          "type": "array", "minItems": 1,
          "items": { "type": "string" }
        },
        "geometry_response": { "type": "boolean" },
        "revision_required": { "type": "boolean" },
        "artifact_write": { "type": "boolean" },
        "ground_truth_behavior": {
          "enum": ["NOT_APPLICABLE", "REQUIRED", "ERROR_IF_ABSENT", "AVAILABILITY_DECLARED"]
        },
        "immutability": {
          "enum": ["NOT_APPLICABLE", "READ_ONLY", "WORKING_ONLY", "NEW_VERSION"]
        },
        "hero_flow": { "type": "boolean" },
        "notes": { "type": "string", "minLength": 1 }
      },
      "if": {
        "required": ["response_fields"],
        "properties": { "response_fields": { "contains": { "const": "items" } } }
      },
      "then": { "required": ["row_fields"] },
      "else": { "not": { "required": ["row_fields"] } }
    },
    "artifact_rules": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "immutable_kinds", "never_overwrite_kinds", "raw_prediction_kind",
        "processed_prediction_kind", "reviewed_mask_kind", "ground_truth_missing_behavior"
      ],
      "properties": {
        "immutable_kinds": {
          "type": "array", "minItems": 1,
          "items": { "type": "string" }
        },
        "never_overwrite_kinds": {
          "type": "array", "minItems": 1,
          "items": { "type": "string" }
        },
        "raw_prediction_kind": { "const": "RAW_PREDICTION_MASK" },
        "processed_prediction_kind": { "const": "PROCESSED_PREDICTION_MASK" },
        "reviewed_mask_kind": { "const": "REVIEWED_MASK" },
        "ground_truth_missing_behavior": { "const": "GROUND_TRUTH_UNAVAILABLE" }
      }
    },
    "revision_rules": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expected_revision_field", "etag_header", "stale_error_code",
        "mutating_methods", "last_write_wins_allowed"
      ],
      "properties": {
        "expected_revision_field": { "const": "expected_revision" },
        "etag_header": { "const": "ETag" },
        "stale_error_code": { "const": "STALE_REVISION" },
        "mutating_methods": {
          "type": "array", "const": ["PATCH", "PUT", "POST_COMMIT"],
          "items": { "type": "string" }
        },
        "last_write_wins_allowed": { "const": false }
      }
    },
    "fixture_rules": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generated_from_schema", "handwritten_fixtures_allowed", "generator"],
      "properties": {
        "generated_from_schema": { "const": true },
        "handwritten_fixtures_allowed": { "const": false },
        "generator": { "const": "generate_fixture.py" }
      }
    }
  }
}
