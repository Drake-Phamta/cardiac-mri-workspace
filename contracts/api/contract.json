    {"id":"analysis_slice_metrics","method":"GET","path":"/api/v1/analysis-runs/{run_id}/slices/{slice_index}/metrics?prediction_variant={variant}","semantic":"Return one slice metric state/value under the empty-slice rule.","response_kind":"JSON","response_fields":["slice_index","metric_state","metric_value","reference_mask_id","prediction_mask_id","metric_version"],"errors":["ARTIFACT_NOT_FOUND","SLICE_OUT_OF_RANGE","RUN_NOT_SUCCEEDED","GROUND_TRUTH_UNAVAILABLE","ANALYSIS_FAILED","UNAUTHORIZED"],"geometry_response":false,"revision_required":false,"artifact_write":false,"ground_truth_behavior":"REQUIRED","notes":"NOT_APPLICABLE is explicit, never coerced to zero."},
    {"id":"analysis_slice_error","method":"GET","path":"/api/v1/analysis-runs/{run_id}/slices/{slice_index}/error?prediction_variant={variant}","semantic":"Return FP/FN/overlap data or a versioned error artifact.","response_kind":"ARTIFACT_REFERENCE","response_fields":["slice_index","error_artifact_id","reference_mask_id","prediction_mask_id","prediction_variant"],"errors":["ARTIFACT_NOT_FOUND","SLICE_OUT_OF_RANGE","RUN_NOT_SUCCEEDED","GROUND_TRUTH_UNAVAILABLE","ANALYSIS_FAILED","UNAUTHORIZED"],"geometry_response":false,"revision_required":false,"artifact_write":false,"ground_truth_behavior":"REQUIRED","notes":"Error semantics are versioned and traceable."},
    {"id":"prediction_slice_get","method":"GET","path":"/api/v1/analysis-runs/{run_id}/slices/{slice_index}/prediction?variant={variant}","semantic":"Return the explicitly requested raw or processed prediction variant.","response_kind":"BINARY","response_fields":["prediction_mask_id","prediction_variant","source_version","checksum","geometry_contract_version","geometry_validation_status","shape","index_convention","spacing","origin","direction"],"errors":["ARTIFACT_NOT_FOUND","SLICE_OUT_OF_RANGE","RUN_NOT_SUCCEEDED","GEOMETRY_NOT_VALIDATED","GEOMETRY_MISMATCH","UNAUTHORIZED"],"geometry_response":true,"revision_required":false,"artifact_write":false,"ground_truth_behavior":"NOT_APPLICABLE","notes":"The backend never silently substitutes processed for raw."},
    {"id":"reconstruction_get","method":"GET","path":"/api/v1/analysis-runs/{run_id}/reconstruction?source_mask_id={mask_id}","semantic":"Return a mesh reference tied to the exact source mask and transform.","response_kind":"ARTIFACT_REFERENCE","response_fields":["mesh_artifact_id","source_mask_id","source_mask_kind","reconstruction_version","geometry_contract_version","geometry_validation_status","shape","index_convention","spacing","origin","direction","mesh_to_world_transform"],"errors":["ARTIFACT_NOT_FOUND","RUN_NOT_SUCCEEDED","GEOMETRY_NOT_VALIDATED","GEOMETRY_MISMATCH","UNAUTHORIZED"],"geometry_response":true,"revision_required":false,"artifact_write":false,"ground_truth_behavior":"NOT_APPLICABLE","notes":"Mesh linkage is explicit, never inferred from a filename."},
    {"id":"error_reconstruction_get","method":"GET","path":"/api/v1/analysis-runs/{run_id}/error-reconstruction?prediction_variant={variant}","semantic":"Return 3-D error reconstruction only with a compatible reference.","response_kind":"ARTIFACT_REFERENCE","response_fields":["error_mesh_artifact_id","reference_mask_id","prediction_mask_id","prediction_variant","geometry_contract_version","geometry_validation_status","shape","index_convention","spacing","origin","direction"],"errors":["ARTIFACT_NOT_FOUND","RUN_NOT_SUCCEEDED","GROUND_TRUTH_UNAVAILABLE","GEOMETRY_NOT_VALIDATED","GEOMETRY_MISMATCH","ANALYSIS_FAILED","UNAUTHORIZED"],"geometry_response":true,"revision_required":false,"artifact_write":false,"ground_truth_behavior":"REQUIRED","notes":"A missing compatible ground truth is an explicit unavailable response."},
    {"id":"review_create","method":"POST","path":"/api/v1/analysis-runs/{run_id}/reviews","semantic":"Create or initialize a persisted review state.","response_kind":"JSON","request_fields":["status"],"response_fields":["review_id","run_id","status","revision","etag"],"errors":["ARTIFACT_NOT_FOUND","RUN_NOT_SUCCEEDED","INVALID_REVIEW_TRANSITION","UNAUTHORIZED"],"geometry_response":false,"revision_required":false,"artifact_write":false,"ground_truth_behavior":"AVAILABILITY_DECLARED","notes":"Initial state is persisted and auditable."},
