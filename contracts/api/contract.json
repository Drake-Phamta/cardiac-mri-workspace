    {"id":"experiment_get","method":"GET","path":"/api/v1/experiments/{experiment_id}","semantic":"Get model, split, subset, preprocessing, checkpoint, and evaluation versions.","response_kind":"JSON","response_fields":["experiment_id","model_family","training_fraction","split_manifest_id","subset_manifest_id","preprocessing_version","postprocessing_version","checkpoint","evaluation_version","prediction_variant"],"errors":["ARTIFACT_NOT_FOUND","UNAUTHORIZED"],"geometry_response":false,"revision_required":false,"artifact_write":false,"ground_truth_behavior":"AVAILABILITY_DECLARED","notes":"Experiment identity is versioned and reproducible."},
    {"id":"experiment_metrics","method":"GET","path":"/api/v1/experiments/{experiment_id}/metrics","semantic":"Return cohort metrics from saved per-case results.","response_kind":"JSON","response_fields":["evaluation_n","successful_n","metric_summary","prediction_variant","metric_version"],"errors":["ARTIFACT_NOT_FOUND","GROUND_TRUTH_UNAVAILABLE","RUN_NOT_SUCCEEDED","UNAUTHORIZED"],"geometry_response":false,"revision_required":false,"artifact_write":false,"ground_truth_behavior":"REQUIRED","notes":"Excluded and failed cases remain visible in counts/status."},
    {"id":"experiment_cases","method":"GET","path":"/api/v1/experiments/{experiment_id}/cases","semantic":"Return per-case metric/status rows for outlier drill-down.","response_kind":"JSON","response_fields":["items","case_id","status","reason","metric_version"],"errors":["ARTIFACT_NOT_FOUND","UNAUTHORIZED"],"geometry_response":false,"revision_required":false,"artifact_write":false,"ground_truth_behavior":"AVAILABILITY_DECLARED","notes":"Failed and excluded rows are not silently dropped."},
