    {"id":"working_mask_put","method":"PUT","path":"/api/v1/reviews/{review_id}/working-mask/slices/{slice_index}","semantic":"Upload one brush-edited working slice tied to an exact source mask.","response_kind":"JSON","request_fields":["source_mask_id","expected_revision","slice_index","geometry_contract_version","geometry_validation_status","mask_payload"],"response_fields":["review_id","working_revision","source_mask_id","slice_index","geometry_contract_version","geometry_validation_status","shape","index_convention","spacing","origin","direction"],"errors":["ARTIFACT_NOT_FOUND","SLICE_OUT_OF_RANGE","STALE_REVISION","IMMUTABLE_ARTIFACT","GEOMETRY_NOT_VALIDATED","GEOMETRY_MISMATCH","VALIDATION_ERROR","UNAUTHORIZED"],"geometry_response":true,"revision_required":true,"artifact_write":true,"immutability":"WORKING_ONLY","ground_truth_behavior":"NOT_APPLICABLE","notes":"Ground truth cannot be used as an implicit source prediction."},
