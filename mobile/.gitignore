# mobile/ - build output and generated inputs stay out of git.

# dependencies
node_modules/

# Expo / Metro
.expo/
dist/
web-build/
expo-env.d.ts
.metro-health-check*

# Native projects: `expo prebuild` regenerates them from app.json, so they are
# build output, not source (same rule as spikes/**/android/ in the root file).
/android/
/ios/
.kotlin/

# Release builds land here with a timestamp file (scripts/build-release.ps1).
# APKs are never committed.
/release/
*.apk
*.aab

# Generated by scripts/prepare.mjs. The fixture bundle comes from
# contracts/api/generate_fixture.py and is never hand-written or committed
# (contract.json fixture_rules.handwritten_fixtures_allowed = false).
/src/generated/

# signing material
*.jks
*.keystore
*.p8
*.p12
*.key
*.mobileprovision

# debug logs
npm-debug.*
yarn-debug.*
yarn-error.*

# local env files
.env*.local
