{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://drake-phamta.github.io/cardiac-mri-workspace/schema/dataset_manifest.schema.json",
  "title": "LASC 2018 dataset acquisition manifest",
  "description": "Machine-readable acquisition manifest required by 06 section 9.1 and Spike D criterion A20. Generated by tools/dataset_validate, never hand-typed. A field that could not be read is the string 'NOT MEASURED - <reason>' rather than being absent.",
  "type": "object",
  "required": [
    "manifest_version", "generated_at", "generated_by", "package_root",
    "nrrd_library", "acquisition", "case_count_total", "partitions",
    "shape_distribution", "cases"
  ],
  "properties": {
    "manifest_version": { "type": "string" },
    "generated_at": { "type": "string", "description": "ISO-8601 with offset" },
    "generated_by": { "type": "string" },
    "package_root": { "type": "string" },
    "nrrd_library": { "type": "string", "description": "library name and exact version" },
    "acquisition": {
      "type": "object",
      "description": "Criterion A1. Supplied by the person who performed the download; not derivable from the package.",
      "properties": {
        "source_url": { "type": "string" },
        "documented_source": { "type": "string" },
        "download_started": { "type": "string" },
        "download_finished": { "type": "string" },
        "acquired_by": { "type": "string" },
        "extraction_location": { "type": "string" },
        "license_terms_path": { "type": "string", "description": "Criterion A18" },
        "attribution_note": { "type": "string" },
        "package_files": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "size_bytes"],
            "properties": {
              "name": { "type": "string" },
              "size_bytes": { "type": "integer", "minimum": 0 },
              "sha256": { "type": "string" }
            }
          }
        }
      }
    },
    "case_count_total": { "type": "integer", "minimum": 0, "description": "Criterion A2" },
    "partitions": {
      "type": "object",
      "description": "Criterion A2 and A12. Keyed by the partition directory name as released.",
      "additionalProperties": {
        "type": "object",
        "required": ["case_count", "cases_with_mri", "cases_with_mask", "all_cases_have_mask"],
        "properties": {
          "case_count": { "type": "integer", "minimum": 0 },
          "cases_with_mri": { "type": "integer", "minimum": 0 },
          "cases_with_mask": { "type": "integer", "minimum": 0 },
          "cases_missing_mask": { "type": "array", "items": { "type": "string" } },
          "all_cases_have_mask": { "type": "boolean" }
        }
      }
    },
    "shape_distribution": {
      "type": "object",
      "description": "Criterion A6. Feeds the Spike A re-measurement of A9 at real slice size.",
      "required": ["distinct_shapes", "counts_by_shape", "in_plane_dimensions_vary"],
      "properties": {
        "distinct_shapes": { "type": "integer", "minimum": 0 },
        "counts_by_shape": { "type": "object", "additionalProperties": { "type": "integer" } },
        "in_plane_dimensions_vary": { "oneOf": [{ "type": "boolean" }, { "type": "string" }] },
        "distinct_in_plane_dimensions": { "type": "array" },
        "volumes_unreadable": { "type": "integer", "minimum": 0 }
      }
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["case_id", "source_dir_relative", "partition_as_released", "files_present", "mri"],
        "properties": {
          "case_id": { "type": "string", "pattern": "^CASE_[0-9]{4}$", "description": "Criterion A16" },
          "source_dir_relative": { "type": "string" },
          "source_dir_name": { "type": "string" },
          "partition_as_released": { "type": "string" },
          "files_present": { "type": "object" },
          "mri": { "$ref": "#/$defs/volume" },
          "mask": { "oneOf": [{ "$ref": "#/$defs/volume" }, { "type": "null" }] },
          "mri_mask_compatibility": {
            "type": "object",
            "description": "Criteria A8 and A9",
            "properties": {
              "shape_equal": {}, "spacing_equal": {}, "origin_equal": {},
              "resampling_required": {}, "basis": { "type": "string" }
            }
          }
        }
      }
    },
    "criteria_results": {
      "type": "array",
      "description": "Written by validate.py alongside the manifest.",
      "items": {
        "type": "object",
        "required": ["criterion", "status"],
        "properties": {
          "criterion": { "type": "string" },
          "title": { "type": "string" },
          "status": { "enum": ["PASS", "FAIL", "NOT_RUN", "OWNER_VERDICT_REQUIRED"] },
          "detail": { "type": "string" }
        }
      }
    },
    "summary": { "type": "object" }
  },
  "$defs": {
    "volume": {
      "type": "object",
      "required": ["path_relative", "size_bytes", "read_ok"],
      "properties": {
        "path_relative": { "type": "string" },
        "size_bytes": { "type": "integer", "minimum": 0 },
        "sha256": { "type": "string", "description": "Criterion A1, where practical" },
        "read_ok": { "type": "boolean" },
        "read_error": { "type": "string" },
        "dtype": {}, "shape": {}, "dimension": {}, "is_3d": {},
        "space": {}, "space_origin": {}, "space_directions": {}, "spacing": {},
        "encoding": {},
        "axis_aligned": { "description": "Criterion A14 / DR-012. true, false, or NOT MEASURED." },
        "axis_aligned_basis": { "type": "string" },
        "has_non_finite": {},
        "value_min": {}, "value_max": {},
        "unique_values": { "description": "Mask only. Criterion A10 - recorded, never assumed." },
        "header_identifier_findings": {
          "description": "Criterion A17. Records the matched KEY and the value length, never the value."
        }
      }
    }
  }
}
